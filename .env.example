# Supabase ---------------------------------------------------------------
# Server-side. The service key bypasses RLS — never expose it to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Browser-side. Anon key is read-only here: RLS grants it select on
# challenges and claims and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payment (Venmo) --------------------------------------------------------
# Your Venmo username, with or without the @. Shown on the confirmation page
# and in the team code email, and used to build the "Open Venmo" link.
# NEXT_PUBLIC_ so the browser can render it — a Venmo handle is public
# information by design, unlike an API key.
NEXT_PUBLIC_VENMO_HANDLE=your-venmo-username

# Required to mark teams paid at /hq. There is no payment webhook to trust,
# so this is the only thing standing between a guessed URL and someone
# marking every team paid. Fails closed: unset means marking paid is disabled.
# Use something long; it is typed once per device, not memorized.
HQ_PASSCODE=

# Site -------------------------------------------------------------------
# No trailing slash — used for the QR targets and email links.
SITE_URL=http://localhost:3000

# Team code email (optional) ---------------------------------------------
# Without these, registration still succeeds and the team code is written to
# the function logs. Codes are always readable from /hq.
RESEND_API_KEY=
TEAM_CODE_FROM_EMAIL="Lost on the BeltLine <hello@example.com>"

# Supabase ---------------------------------------------------------------
# Server-side. The service key bypasses RLS — never expose it to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Browser-side. Anon key is read-only here: RLS grants it select on
# challenges and claims and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe dashboard webhook endpoint, or `stripe listen` in dev.
STRIPE_WEBHOOK_SECRET=whsec_...

# Site -------------------------------------------------------------------
# No trailing slash — used to build Stripe redirect URLs and the QR targets.
SITE_URL=http://localhost:3000

# Team code email (optional) ---------------------------------------------
# Without these the webhook logs the team code instead of emailing it, and
# registration still succeeds. Codes are always readable from /hq.
RESEND_API_KEY=
TEAM_CODE_FROM_EMAIL="Lost on the BeltLine <hello@example.com>"
